{
  "name": "okf-template",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "run-p --continue-on-error --aggregate-output --print-label lint:md lint:format lint:okf",
    "lint:md": "rumdl check .",
    "lint:format": "rumdl fmt --check .",
    "lint:okf": "node scripts/okf-check.ts",
    "fix": "rumdl fmt .",
    "test": "node --test scripts/*.test.ts"
  },
  "devDependencies": {
    "npm-run-all2": "9.0.4",
    "rumdl": "0.3.2",
    "yaml": "2.9.1"
  }
}
